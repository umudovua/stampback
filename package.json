{
  "name": "stampback",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./tools/*\" typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "determinism": "pnpm --filter @stampback/determinism-check check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
